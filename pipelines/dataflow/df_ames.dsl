source(output(
		PID as long,
		{Lot Frontage} as string,
		{Lot Area} as string,
		Street as string,
		Alley as string,
		{Lot Shape} as string,
		{Land Contour} as string,
		Utilities as string,
		{Lot Config} as string,
		{Land Slope} as string,
		Neighborhood as string,
		{Condition 1} as string,
		{Condition 2} as string,
		{Bldg Type} as string,
		{House Style} as string,
		{Overall Qual} as string,
		{Overall Cond} as string,
		{Year Built} as string,
		{Year Remod/Add} as string
	),
	allowSchemaDrift: true,
	validateSchema: false,
	ignoreNoFilesFound: false) ~> csv
source(output(
		PID as long,
		{MS SubClass} as long,
		{MS Zoning} as string,
		{Roof Style} as string,
		{Roof Matl} as string,
		{Exterior 1st} as string,
		{Exterior 2nd} as string,
		{Mas Vnr Type} as string,
		{Mas Vnr Area} as long,
		{Exter Qual} as string,
		{Exter Cond} as string,
		Foundation as string,
		Heating as string,
		{Heating QC} as string,
		{Central Air} as string,
		Electrical as string,
		{1st Flr SF} as long,
		{2nd Flr SF} as long,
		{Low Qual Fin SF} as long,
		{Gr Liv Area} as long,
		{Full Bath} as integer,
		{Half Bath} as integer,
		{Bedroom AbvGr} as integer,
		{Kitchen AbvGr} as long,
		{Kitchen Qual} as string,
		{TotRms AbvGrd} as long,
		Functional as string,
		Fireplaces as long,
		{Fireplace Qu} as string,
		{Paved Drive} as string,
		{Wood Deck SF} as long,
		{Open Porch SF} as long,
		{Enclosed Porch} as long,
		{3Ssn Porch} as long,
		{Screen Porch} as long,
		Fence as string,
		{Mo Sold} as integer,
		{Yr Sold} as integer,
		{Sale Type} as string,
		{Sale Condition} as string,
		SalePrice as long
	),
	allowSchemaDrift: true,
	validateSchema: false,
	isolationLevel: 'READ_UNCOMMITTED',
	query: 'SELECT\r\n    am."1st Flr SF" + am."2nd Flr SF" + am."Low Qual Fin SF"  AS "Gr Liv Area",\r\n    COALESCE(fd.fullbath, 0)                               AS "Full Bath",\r\n    COALESCE(fd.halfbath, 0)                               AS "Half Bath",\r\n    COALESCE(fd.bedroom, 0)                                 AS "Bedroom AbvGr",\r\n    CAST(EXTRACT(MONTH FROM sp."Sale Date") AS integer)     AS "Mo Sold",\r\n    CAST(EXTRACT(YEAR  FROM sp."Sale Date") AS integer)     AS "Yr Sold",\r\n    am.pid                                                 AS "PID",\r\n    am."MS SubClass"                                       AS "MS SubClass",\r\n    mz.code                                                AS "MS Zoning",\r\n    am."Roof Style"                                        AS "Roof Style",\r\n    am."Roof Matl"                                         AS "Roof Matl",\r\n    am."Exterior 1st"                                      AS "Exterior 1st",\r\n    am."Exterior 2nd"                                      AS "Exterior 2nd",\r\n    COALESCE(am."Mas Vnr Type", \'NA\')                      AS "Mas Vnr Type",\r\n    COALESCE(am."Mas Vnr Area", 0)                         AS "Mas Vnr Area",\r\n    eq.code                                                AS "Exter Qual",\r\n    ec.code                                                AS "Exter Cond",\r\n    am.foundation                                          AS "Foundation",\r\n    am.heating                                             AS "Heating",\r\n    hq.code                                                AS "Heating QC",\r\n    CASE WHEN am."Central Air" THEN \'Y\' ELSE \'N\' END       AS "Central Air",\r\n    COALESCE(am.electrical, \'NA\')                          AS "Electrical",\r\n    am."1st Flr SF"                                        AS "1st Flr SF",\r\n    am."2nd Flr SF"                                        AS "2nd Flr SF",\r\n    am."Low Qual Fin SF"                                   AS "Low Qual Fin SF",\r\n    am."Kitchen AbvGr"                                     AS "Kitchen AbvGr",\r\n    kq.code                                                AS "Kitchen Qual",\r\n    am."TotRms AbvGrd"                                     AS "TotRms AbvGrd",\r\n    am.functional                                          AS "Functional",\r\n    am.fireplaces                                          AS "Fireplaces",\r\n    am."Fireplace Qu"                                      AS "Fireplace Qu",\r\n    am."Paved Drive"                                       AS "Paved Drive",\r\n    am."Wood Deck SF"                                      AS "Wood Deck SF",\r\n    am."Open Porch SF"                                     AS "Open Porch SF",\r\n    am."Enclosed Porch"                                    AS "Enclosed Porch",\r\n    am."3Ssn Porch"                                        AS "3Ssn Porch",\r\n    am."Screen Porch"                                      AS "Screen Porch",\r\n    am.fence                                               AS "Fence",\r\n    sp."Sale Type"                                         AS "Sale Type",\r\n    sp."Sale Condition"                                    AS "Sale Condition",\r\n    sp.saleprice                                           AS "SalePrice"\r\nFROM public.amesdbtemp am\r\nLEFT JOIN public.mszoning     mz ON mz.id = am."MS Zoning"\r\nLEFT JOIN public.typequality  eq ON eq.id = am."Exter Qual"\r\nLEFT JOIN public.typequality  ec ON ec.id = am."Exter Cond"\r\nLEFT JOIN public.typequality  hq ON hq.id = am."Heating QC"\r\nLEFT JOIN public.typequality  kq ON kq.id = am."Kitchen Qual"\r\nLEFT JOIN public.saleproperty sp ON sp.pid = am.pid\r\nLEFT JOIN (\r\n    SELECT pid,\r\n           CAST(SUM(bedrooms)    AS integer) AS bedroom,\r\n           CAST(SUM("Full Bath") AS integer) AS fullbath,\r\n           CAST(SUM("Half Bath") AS integer) AS halfbath\r\n    FROM public.floordetail\r\n    GROUP BY pid\r\n) fd ON fd.pid = am.pid',
	format: 'query') ~> Postgress
source(output(
		PID as long,
		{Pool Area} as short,
		{Pool QC} as string
	),
	allowSchemaDrift: true,
	validateSchema: false,
	ignoreNoFilesFound: false) ~> DsPool
source(output(
		PID as long,
		{Garage Type} as string,
		{Garage Yr Blt} as short,
		{Garage Finish} as string,
		{Garage Cars} as short,
		{Garage Area} as short,
		{Garage Qual} as string,
		{Garage Cond} as string
	),
	allowSchemaDrift: true,
	validateSchema: false,
	ignoreNoFilesFound: false) ~> DsGarage
source(output(
		PID as long,
		{Bsmt Qual} as string,
		{Bsmt Cond} as string,
		{Bsmt Exposure} as string,
		{BsmtFin Type 1} as string,
		{BsmtFin SF 1} as short,
		{BsmtFin Type 2} as string,
		{BsmtFin SF 2} as short,
		{Bsmt Unf SF} as short,
		{Total Bsmt SF} as short,
		{Bsmt Full Bath} as short,
		{Bsmt Half Bath} as short
	),
	allowSchemaDrift: true,
	validateSchema: false,
	ignoreNoFilesFound: false) ~> DsBsmt
source(output(
		PID as long,
		{Misc Feature} as string,
		{Misc Val} as short
	),
	allowSchemaDrift: true,
	validateSchema: false,
	ignoreNoFilesFound: false) ~> DsMisc
csv, Postgress join(csv@PID == Postgress@PID,
	joinType:'left',
	matchType:'exact',
	ignoreSpaces: false,
	broadcast: 'auto')~> joinpostgress
joinpostgress, DsPool join(csv@PID == DsPool@PID,
	joinType:'left',
	matchType:'exact',
	ignoreSpaces: false,
	broadcast: 'auto')~> joinpool
joinpool, DsGarage join(csv@PID == DsGarage@PID,
	joinType:'left',
	matchType:'exact',
	ignoreSpaces: false,
	broadcast: 'auto')~> joingarage
joingarage, DsBsmt join(csv@PID == DsBsmt@PID,
	joinType:'left',
	matchType:'exact',
	ignoreSpaces: false,
	broadcast: 'auto')~> joinbmst
joinbmst, DsMisc join(csv@PID == DsMisc@PID,
	joinType:'left',
	matchType:'exact',
	ignoreSpaces: false,
	broadcast: 'auto')~> joinmisc
joinmisc derive({Year Remod/Add} = iifNull({Year Remod/Add}, {Year Built}),
		{Pool QC} = iifNull({Pool QC}, 'NA'),
		{Pool Area} = iifNull({Pool Area}, toShort(0)),
		{Garage Type} = iifNull({Garage Type}, 'NA'),
		{Garage Finish} = iifNull({Garage Finish}, 'NA'),
		{Garage Qual} = iifNull({Garage Qual}, 'NA'),
		{Garage Cond} = iifNull({Garage Cond}, 'NA'),
		{Garage Yr Blt} = iifNull({Garage Yr Blt}, toShort('0')),
		{Garage Cars} = iifNull({Garage Cars}, toShort('0')),
		{Garage Area} = iifNull({Garage Area}, toShort('0')),
		{Bsmt Qual} = iifNull({Bsmt Qual}, 'NA'),
		{Bsmt Cond} = iifNull({Bsmt Cond}, 'NA'),
		{Bsmt Exposure} = iifNull({Bsmt Exposure}, 'NA'),
		{BsmtFin Type 1} = iifNull({BsmtFin Type 1}, 'NA'),
		{BsmtFin Type 2} = iifNull({BsmtFin Type 2}, 'NA'),
		{BsmtFin SF 1} = iifNull({BsmtFin SF 1}, toShort('0')),
		{BsmtFin SF 2} = iifNull({BsmtFin SF 2}, toShort('0')),
		{Bsmt Unf SF} = iifNull({Bsmt Unf SF}, toShort('0')),
		{Total Bsmt SF} = iifNull({Total Bsmt SF}, toShort('0')),
		{Bsmt Full Bath} = iifNull({Bsmt Full Bath}, toShort('0')),
		{Bsmt Half Bath} = iifNull({Bsmt Half Bath}, toShort('0')),
		{Misc Feature} = iifNull({Misc Feature}, 'NA'),
		{Misc Val} = iifNull({Misc Val}, toShort('0')),
		{Lot Shape} = case(     {Lot Shape} == 'Regular', 'Reg',     {Lot Shape} == 'Slightly irregular', 'IR1',     {Lot Shape} == 'Moderately Irregular', 'IR2',     {Lot Shape} == 'Irregular', 'IR3',     {Lot Shape} ),
		Neighborhood = case(     Neighborhood == 'Bloomington Heights', 'Blmngtn',     Neighborhood == 'Bluestem', 'Blueste',     Neighborhood == 'Briardale', 'BrDale',     Neighborhood == 'Brookside', 'BrkSide',     Neighborhood == 'Clear Creek', 'ClearCr',     Neighborhood == 'College Creek', 'CollgCr',     Neighborhood == 'Crawford', 'Crawfor',     Neighborhood == 'Iowa DOT and Rail Road', 'IDOTRR',     Neighborhood == 'Meadow Village', 'MeadowV',     Neighborhood == 'Mitchell', 'Mitchel',     Neighborhood == 'North Ames', 'Names',     Neighborhood == 'Northridge', 'NoRidge',     Neighborhood == 'Northpark Villa', 'NPkVill',     Neighborhood == 'Northridge Heights', 'NridgHt',     Neighborhood == 'Northwest Ames', 'NWAmes',     Neighborhood == 'Old Town', 'OldTown',     Neighborhood == 'South & West of Iowa State University', 'SWISU',     Neighborhood == 'Sawyer West', 'SawyerW',     Neighborhood == 'Somerset', 'Somerst',     Neighborhood == 'Stone Brook', 'StoneBr',     Neighborhood == 'Timberland', 'Timber',     Neighborhood ),
		{Condition 1} = case(     {Condition 1} == 'Normal', 'Norm',     {Condition 1} == 'Adjacent to feeder street', 'Feedr',     {Condition 1} == 'Adjacent to arterial street', 'Artery',     {Condition 1} == 'Adjacent to East-West Railroad', 'RRAe',     {Condition 1} == 'Adjacent to North-South Railroad', 'RRAn',     startsWith({Condition 1}, 'Within 200') && endsWith({Condition 1}, 'North-South Railroad'), 'RRNn',     startsWith({Condition 1}, 'Within 200') && endsWith({Condition 1}, 'East-West Railroad'), 'RRNe',     startsWith({Condition 1}, 'Near positive'), 'PosN',     startsWith({Condition 1}, 'Adjacent to pos'), 'PosA',     {Condition 1} ),
		{Condition 2} = case(     {Condition 2} == 'Normal', 'Norm',     {Condition 2} == 'Adjacent to feeder street', 'Feedr',     {Condition 2} == 'Adjacent to arterial street', 'Artery',     {Condition 2} == 'Adjacent to East-West Railroad', 'RRAe',     {Condition 2} == 'Adjacent to North-South Railroad', 'RRAn',     startsWith({Condition 2}, 'Within 200') && endsWith({Condition 2}, 'North-South Railroad'), 'RRNn',     startsWith({Condition 2}, 'Within 200') && endsWith({Condition 2}, 'East-West Railroad'), 'RRNe',     startsWith({Condition 2}, 'Near positive'), 'PosN',     startsWith({Condition 2}, 'Adjacent to pos'), 'PosA',     {Condition 2} ),
		{Lot Frontage} = iifNull({Lot Frontage}, '0'),
		{Sale Type} = trim({Sale Type})) ~> cambios
cambios select(mapColumn(
		pid = csv@PID,
		ms_sub_class = {MS SubClass},
		ms_zoning = {MS Zoning},
		lot_frontage = {Lot Frontage},
		lot_area = {Lot Area},
		street = Street,
		alley = Alley,
		lot_shape = {Lot Shape},
		land_contour = {Land Contour},
		utilities = Utilities,
		lot_config = {Lot Config},
		land_slope = {Land Slope},
		neighborhood = Neighborhood,
		condition_1 = {Condition 1},
		condition_2 = {Condition 2},
		bldg_type = {Bldg Type},
		house_style = {House Style},
		overall_qual = {Overall Qual},
		overall_cond = {Overall Cond},
		year_built = {Year Built},
		year_remod_add = {Year Remod/Add},
		roof_style = {Roof Style},
		roof_matl = {Roof Matl},
		exterior_1st = {Exterior 1st},
		exterior_2nd = {Exterior 2nd},
		mas_vnr_type = {Mas Vnr Type},
		mas_vnr_area = {Mas Vnr Area},
		exter_qual = {Exter Qual},
		exter_cond = {Exter Cond},
		foundation = Foundation,
		bsmt_qual = {Bsmt Qual},
		bsmt_cond = {Bsmt Cond},
		bsmt_exposure = {Bsmt Exposure},
		bsmt_fin_type_1 = {BsmtFin Type 1},
		bsmt_fin_sf_1 = {BsmtFin SF 1},
		bsmt_fin_type_2 = {BsmtFin Type 2},
		bsmt_fin_sf_2 = {BsmtFin SF 2},
		bsmt_unf_sf = {Bsmt Unf SF},
		total_bsmt_sf = {Total Bsmt SF},
		heating = Heating,
		heating_qc = {Heating QC},
		central_air = {Central Air},
		electrical = Electrical,
		first_flr_sf = {1st Flr SF},
		second_flr_sf = {2nd Flr SF},
		low_qual_fin_sf = {Low Qual Fin SF},
		gr_liv_area = {Gr Liv Area},
		bsmt_full_bath = {Bsmt Full Bath},
		bsmt_half_bath = {Bsmt Half Bath},
		full_bath = {Full Bath},
		half_bath = {Half Bath},
		bedroom_abv_gr = {Bedroom AbvGr},
		kitchen_abv_gr = {Kitchen AbvGr},
		kitchen_qual = {Kitchen Qual},
		tot_rms_abv_grd = {TotRms AbvGrd},
		functional = Functional,
		fireplaces = Fireplaces,
		fireplace_qu = {Fireplace Qu},
		garage_type = {Garage Type},
		garage_yr_blt = {Garage Yr Blt},
		garage_finish = {Garage Finish},
		garage_cars = {Garage Cars},
		garage_area = {Garage Area},
		garage_qual = {Garage Qual},
		garage_cond = {Garage Cond},
		paved_drive = {Paved Drive},
		wood_deck_sf = {Wood Deck SF},
		open_porch_sf = {Open Porch SF},
		enclosed_porch = {Enclosed Porch},
		three_ssn_porch = {3Ssn Porch},
		screen_porch = {Screen Porch},
		pool_area = {Pool Area},
		pool_qc = {Pool QC},
		fence = Fence,
		misc_feature = {Misc Feature},
		misc_val = {Misc Val},
		mo_sold = {Mo Sold},
		yr_sold = {Yr Sold},
		sale_type = {Sale Type},
		sale_condition = {Sale Condition},
		sale_price = SalePrice
	),
	skipDuplicateMapInputs: true,
	skipDuplicateMapOutputs: true) ~> SelectorFinal
SelectorFinal sink(allowSchemaDrift: true,
	validateSchema: false,
	partitionFileNames:['salida.csv'],
	skipDuplicateMapInputs: true,
	skipDuplicateMapOutputs: true,
	partitionBy('hash', 1)) ~> salida