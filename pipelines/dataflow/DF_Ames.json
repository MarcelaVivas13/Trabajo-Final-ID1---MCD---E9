{
	"name": "DF_Ames",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AmesPropertyCSV",
						"type": "DatasetReference"
					},
					"name": "csvProps"
				},
				{
					"dataset": {
						"referenceName": "amesdbtemp",
						"type": "DatasetReference"
					},
					"name": "pgAmes"
				},
				{
					"dataset": {
						"referenceName": "floordetail",
						"type": "DatasetReference"
					},
					"name": "pgFloor"
				},
				{
					"dataset": {
						"referenceName": "saleproperty",
						"type": "DatasetReference"
					},
					"name": "pgSale"
				},
				{
					"dataset": {
						"referenceName": "mszoning",
						"type": "DatasetReference"
					},
					"name": "pgZoning"
				},
				{
					"dataset": {
						"referenceName": "typequality",
						"type": "DatasetReference"
					},
					"name": "pgQuality"
				},
				{
					"dataset": {
						"referenceName": "DS_garage",
						"type": "DatasetReference"
					},
					"name": "mGarage"
				},
				{
					"dataset": {
						"referenceName": "DS_bsmt",
						"type": "DatasetReference"
					},
					"name": "mBsmt"
				},
				{
					"dataset": {
						"referenceName": "DS_pool",
						"type": "DatasetReference"
					},
					"name": "mPool"
				},
				{
					"dataset": {
						"referenceName": "DS_misc",
						"type": "DatasetReference"
					},
					"name": "mMisc"
				}
			],
			"sinks": [
				{
					"name": "cacheQual"
				},
				{
					"name": "cacheZone"
				}
			],
			"transformations": [
				{
					"name": "aggFloor"
				},
				{
					"name": "derSale",
					"description": "Deriva mes de venta (Mo Sold) y año de venta (Yr Sold)"
				},
				{
					"name": "derAmes",
					"description": "Crea columna Gr Liv Area, MS Zoning (Code), Exter Qual (Code), Exter Cond (Code), Heating QC (Code), Kitchen Qual (Code)"
				},
				{
					"name": "derCsv",
					"description": "Actualiza Year Remod/Add\nCrea Lot Shape\nCrea Neighborhood"
				},
				{
					"name": "joinAmes"
				},
				{
					"name": "joinSale"
				},
				{
					"name": "joinFloor"
				},
				{
					"name": "joinGarage"
				},
				{
					"name": "joinBsmt"
				},
				{
					"name": "joinPool"
				},
				{
					"name": "joinMisc"
				},
				{
					"name": "derNA"
				}
			],
			"scriptLines": [
				"source(output(",
				"          PID as integer,",
				"          {Lot Frontage} as short,",
				"          {Lot Area} as integer,",
				"          Street as string,",
				"          Alley as string,",
				"          {Lot Shape} as string,",
				"          {Land Contour} as string,",
				"          Utilities as string,",
				"          {Lot Config} as string,",
				"          {Land Slope} as string,",
				"          Neighborhood as string,",
				"          {Condition 1} as string,",
				"          {Condition 2} as string,",
				"          {Bldg Type} as string,",
				"          {House Style} as string,",
				"          {Overall Qual} as short,",
				"          {Overall Cond} as short,",
				"          {Year Built} as short,",
				"          {Year Remod/Add} as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csvProps",
				"source(output(",
				"          {Exter Cond} as long,",
				"          {Exter Qual} as long,",
				"          {Heating QC} as long,",
				"          {Kitchen Qual} as long,",
				"          {MS Zoning} as long,",
				"          pid as long,",
				"          {Roof Style} as string,",
				"          {Roof Matl} as string,",
				"          {Exterior 1st} as string,",
				"          {Exterior 2nd} as string,",
				"          {Mas Vnr Type} as string,",
				"          {Mas Vnr Area} as long,",
				"          foundation as string,",
				"          heating as string,",
				"          {Central Air} as boolean,",
				"          electrical as string,",
				"          {1st Flr SF} as long,",
				"          {2nd Flr SF} as long,",
				"          {Low Qual Fin SF} as long,",
				"          {Kitchen AbvGr} as long,",
				"          {TotRms AbvGrd} as long,",
				"          functional as string,",
				"          fireplaces as long,",
				"          {Fireplace Qu} as string,",
				"          {Paved Drive} as string,",
				"          {Wood Deck SF} as long,",
				"          {Open Porch SF} as long,",
				"          {Enclosed Porch} as long,",
				"          {3Ssn Porch} as long,",
				"          {Screen Porch} as long,",
				"          fence as string,",
				"          {MS SubClass} as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> pgAmes",
				"source(output(",
				"          pid as long,",
				"          Floor as long,",
				"          bedrooms as long,",
				"          {Full Bath} as long,",
				"          {Half Bath} as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> pgFloor",
				"source(output(",
				"          pid as long,",
				"          {Sale Date} as timestamp,",
				"          {Sale Type} as string,",
				"          {Sale Condition} as string,",
				"          saleprice as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> pgSale",
				"source(output(",
				"          id as long,",
				"          description as string,",
				"          code as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> pgZoning",
				"source(output(",
				"          id as long,",
				"          code as string,",
				"          description as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> pgQuality",
				"source(output(",
				"          PID as long,",
				"          {Garage Type} as string,",
				"          {Garage Yr Blt} as string,",
				"          {Garage Finish} as string,",
				"          {Garage Cars} as string,",
				"          {Garage Area} as string,",
				"          {Garage Qual} as string,",
				"          {Garage Cond} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> mGarage",
				"source(output(",
				"          PID as long,",
				"          {Bsmt Qual} as string,",
				"          {Bsmt Cond} as string,",
				"          {Bsmt Exposure} as string,",
				"          {BsmtFin Type 1} as string,",
				"          {BsmtFin SF 1} as string,",
				"          {BsmtFin Type 2} as string,",
				"          {BsmtFin SF 2} as string,",
				"          {Bsmt Unf SF} as string,",
				"          {Total Bsmt SF} as string,",
				"          {Bsmt Full Bath} as string,",
				"          {Bsmt Half Bath} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> mBsmt",
				"source(output(",
				"          PID as long,",
				"          {Pool Area} as string,",
				"          {Pool QC} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> mPool",
				"source(output(",
				"          PID as long,",
				"          {Misc Feature} as string,",
				"          {Misc Val} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> mMisc",
				"pgFloor aggregate(groupBy(pid),",
				"     {Full Bath} = sum({Full Bath}),",
				"          {Half Bath} = sum({Half Bath}),",
				"          {Bedroom AbvGr} = sum(bedrooms)) ~> aggFloor",
				"pgSale derive({Mo Sold} = month({Sale Date}),",
				"          {Yr Sold} = year({Sale Date})) ~> derSale",
				"pgAmes derive({Gr Liv Area} = {1st Flr SF}+{2nd Flr SF}+{Low Qual Fin SF},",
				"          {Central Air} = iif({Central Air}, 'Y', 'N'),",
				"          {MS Zoning} = cacheZone#lookup({MS Zoning}).code,",
				"          {Exter Qual} = cacheQual#lookup({Exter Qual}).code,",
				"          {Exter Cond} = cacheQual#lookup({Exter Cond}).code,",
				"          {Heating QC} = cacheQual#lookup({Heating QC}).code,",
				"          {Kitchen Qual} = cacheQual#lookup({Kitchen Qual}).code) ~> derAmes",
				"csvProps derive(PID = toLong(PID),",
				"          {Year Remod/Add} = iifNull({Year Remod/Add},{Year Built}),",
				"          {Lot Shape} = case({Lot Shape}=='Regular','Reg', {Lot Shape}=='Slightly irregular','IR1', {Lot Shape}=='Moderately Irregular','IR2', {Lot Shape}=='Irregular','IR3', {Lot Shape}),",
				"          Neighborhood = case(Neighborhood=='Bloomington Heights','Blmngtn', Neighborhood=='Bluestem','Blueste', Neighborhood=='Briardale','BrDale', Neighborhood=='Brookside','BrkSide', Neighborhood=='Clear Creek','ClearCr', Neighborhood=='College Creek','CollgCr', Neighborhood=='Crawford','Crawfor', Neighborhood=='Edwards','Edwards', Neighborhood=='Gilbert','Gilbert', Neighborhood=='Iowa DOT and Rail Road','IDOTRR', Neighborhood=='Meadow Village','MeadowV', Neighborhood=='Mitchell','Mitchel', Neighborhood=='North Ames','NAmes', Neighborhood=='Northridge','NoRidge', Neighborhood=='Northpark Villa','NPkVill', Neighborhood=='Northridge Heights','NridgHt', Neighborhood=='Northwest Ames','NWAmes', Neighborhood=='Old Town','OldTown', Neighborhood=='South & West of Iowa State University','SWISU', Neighborhood=='Sawyer','Sawyer', Neighborhood=='Sawyer West','SawyerW', Neighborhood=='Somerset','Somerst', Neighborhood=='Stone Brook','StoneBr', Neighborhood=='Timberland','Timber', Neighborhood=='Veenker','Veenker', Neighborhood),",
				"          {Condition 1} = case({Condition 1}=='Normal','Norm', {Condition 1}=='Adjacent to arterial street','Artery', {Condition 1}=='Adjacent to feeder street','Feedr', {Condition 1}==\"Within 200' of North-South Railroad\",'RRNn', {Condition 1}=='Adjacent to North-South Railroad','RRAn', {Condition 1}=='Near positive off-site feature--park, greenbelt, etc.','PosN', {Condition 1}=='Adjacent to postive off-site feature','PosA', {Condition 1}==\"Within 200' of East-West Railroad\",'RRNe', {Condition 1}=='Adjacent to East-West Railroad','RRAe', {Condition 1}),",
				"          {Condition 2} = case({Condition 2}=='Normal','Norm', {Condition 2}=='Adjacent to arterial street','Artery', {Condition 2}=='Adjacent to feeder street','Feedr', {Condition 2}==\"Within 200' of North-South Railroad\",'RRNn', {Condition 2}=='Adjacent to North-South Railroad','RRAn', {Condition 2}=='Near positive off-site feature--park, greenbelt, etc.','PosN', {Condition 2}=='Adjacent to postive off-site feature','PosA', {Condition 2}==\"Within 200' of East-West Railroad\",'RRNe', {Condition 2}=='Adjacent to East-West Railroad','RRAe', {Condition 2})) ~> derCsv",
				"derCsv, derAmes join(derCsv@PID == pgAmes@pid,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinAmes",
				"joinAmes, derSale join(derCsv@PID == pgSale@pid,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinSale",
				"joinSale, aggFloor join(derCsv@PID == aggFloor@pid,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinFloor",
				"joinFloor, mGarage join(derCsv@PID == mGarage@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinGarage",
				"joinGarage, mBsmt join(derCsv@PID == mBsmt@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinBsmt",
				"joinBsmt, mPool join(derCsv@PID == mPool@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinPool",
				"joinPool, mMisc join(derCsv@PID == mMisc@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinMisc",
				"joinMisc derive(each(match(in(['Garage Type','Garage Finish','Garage Qual','Garage Cond','Bsmt Qual','Bsmt Cond','Bsmt Exposure','BsmtFin Type 1','BsmtFin Type 2','Pool QC','Misc Feature'],name)), $$ = iifNull($$, 'NA')),",
				"          each(match(in(['Garage Yr Blt','Garage Cars','Garage Area','BsmtFin SF 1','BsmtFin SF 2','Bsmt Unf SF','Total Bsmt SF','Bsmt Full Bath','Bsmt Half Bath','Pool Area','Misc Val'],name)), $$ = iifNull($$, 0))) ~> derNA",
				"pgQuality sink(validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     keys:['id'],",
				"     store: 'cache',",
				"     format: 'inline',",
				"     output: false,",
				"     saveOrder: 1) ~> cacheQual",
				"pgZoning sink(validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     keys:['id'],",
				"     store: 'cache',",
				"     format: 'inline',",
				"     output: false,",
				"     saveOrder: 1) ~> cacheZone"
			]
		}
	}
}